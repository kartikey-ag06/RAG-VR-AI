# VR_RAG settings for YOUR computer.
# 1. Copy this file to ".env" (SETUP_DEV.bat does it for you).
# 2. Fill in at least GROQ_API_KEY.
# ".env" is in .gitignore: it is never committed. Never put real keys in this example file.
#
# Real environment variables (Render, CI, your shell) always win over this file.

# ---------------------------------------------------------------------------------- required
# Your OWN free key from https://console.groq.com/keys  (each developer uses their own - never share keys)
GROQ_API_KEY=

# ---------------------------------------------------------------------------------- database (leave empty!)
# Empty = your documents and app data stay on this computer (backend/data/). This is right for development.
# NEVER paste the production Neon URL here: on first start the server copies your local documents INTO that
# database, and your tests/experiments would change real users' data. Need Postgres? Create your own Neon
# branch (Neon dashboard -> Branches -> New branch) and use that branch's URL.
DATABASE_URL=

# ---------------------------------------------------------------------------------- access control (optional)
# Empty = on your own computer you are admin automatically. Set a value to test the "protected server" mode.
ADMIN_TOKEN=
# Token for MCP clients (Claude Desktop, Cursor...) calling /mcp from another machine
MCP_TOKEN=

# ---------------------------------------------------------------------------------- load protection (optional)
# Defaults are fine. Lower them to test the "too many requests" behaviour.
# RATE_AI_PER_MIN=20
# RATE_AI_BURST=8
# AI_DAILY_PER_CALLER=400
# AI_DAILY_TOTAL=5000
# AI_MAX_CONCURRENT=6
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------- remote expert video (optional)
# Only needed to test video calls across different networks. See deploy/turn/.
# TURN_URLS=turn:turn.example.com:3478
# TURN_SECRET=

# ---------------------------------------------------------------------------------- advanced (optional)
# Where documents and app data are stored (default: backend/data)
# VR_RAG_DATA_DIR=
# Embedding model for semantic search (default: BAAI/bge-small-en-v1.5)
# VR_RAG_EMBED_MODEL=
