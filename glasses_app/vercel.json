{
  "installCommand": "npm install --onnxruntime-node-install-cuda=skip",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://vr-rag-backend.onrender.com/api/:path*"
    },
    {
      "source": "/theme/:path*",
      "destination": "https://vr-rag-backend.onrender.com/theme/:path*"
    },
    {
      "source": "/upload",
      "destination": "https://vr-rag-backend.onrender.com/upload"
    },
    {
      "source": "/procops",
      "destination": "https://vr-rag-backend.onrender.com/procops"
    },
    {
      "source": "/rag/:path*",
      "destination": "https://vr-rag-backend.onrender.com/rag/:path*"
    },
    {
      "source": "/workspace",
      "destination": "https://vr-rag-backend.onrender.com/workspace"
    },
    {
      "source": "/expert",
      "destination": "https://vr-rag-backend.onrender.com/expert"
    },
    {
      "source": "/admin",
      "destination": "https://vr-rag-backend.onrender.com/admin"
    },
    {
      "source": "/mcp",
      "destination": "https://vr-rag-backend.onrender.com/mcp"
    }
  ]
}