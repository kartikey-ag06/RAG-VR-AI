{
  "name": "@rag-vr-ai/sdk",
  "version": "1.0.0",
  "description": "Zero-dependency typed TypeScript client SDK for the RAG-VR-AI /api/v1 partner API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
